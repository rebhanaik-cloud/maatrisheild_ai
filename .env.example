# Frontend uses this URL when calling the API
VITE_API_URL=http://localhost:8000

# Backend environment variables (set these in backend shell or hosting settings)
MAATRISHIELD_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
# Optional: postgres connection string, e.g. postgresql+psycopg://user:password@host:5432/maatrishield
# DATABASE_URL=sqlite:///./maatrishield.db
# CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.example
