# =========================================================
# Frontend Environment Variables (Vite)
# =========================================================
# In local development: http://localhost:8000
# In production on Vercel: https://maatrisheild-ai.onrender.com
VITE_API_URL=http://localhost:8000

# =========================================================
# Backend Environment Variables (FastAPI / Render)
# =========================================================
# Secure random key for signing JWT tokens (min 32 characters)
MAATRISHIELD_SECRET_KEY=replace-with-a-secure-random-secret-key-before-deploying

# Database Connection:
# - Local development default: sqlite:///./maatrishield.db
# - Render PostgreSQL: postgresql+psycopg://username:password@hostname:5432/databasename
DATABASE_URL=sqlite:///./maatrishield.db

# Allowed CORS Origins (comma-separated):
# Automatically includes localhost and *.vercel.app by default.
CORS_ORIGINS=http://localhost:5173,https://maatrisheild-ai-three.vercel.app,https://maatrisheild-ai.vercel.app

# JWT access token lifetime in minutes (default 1440 = 24 hours)
ACCESS_TOKEN_MINUTES=1440
